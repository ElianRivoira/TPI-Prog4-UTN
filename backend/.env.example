# Copiar como .env y completar. El .env nunca se sube al repositorio.

# Conexión a PostgreSQL. El "+psycopg2" es obligatorio: desde SQLAlchemy 2.1,
# "postgresql://" usa el driver psycopg 3, que no está instalado.
# Para desarrollo sin PostgreSQL: DATABASE_URL=sqlite:///./foodstore.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/foodstore_db

# Clave para firmar el JWT, de al menos 32 caracteres. Generar una propia con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend autorizado por CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173

# Opcional: true en producción con HTTPS, para que la cookie de sesión no viaje sin cifrar
COOKIE_SECURE=false
